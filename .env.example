# Supabase project credentials (client-safe: anon key is protected by RLS).
# Copy this file to .env.local and paste your own values from:
#   Supabase Dashboard → Project Settings → API
# VITE_* variables are inlined at BUILD time — set the same two vars in Vercel
# (Production + Preview) BEFORE deploying.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
